# ===== Brakket - variables de entorno (raíz del monorepo) =====
# Copiar a .env y completar. NO subir .env al repositorio.
# Lo usa docker-compose.yml (en esta carpeta) y también el backend si exportas
# estas variables al correr ./mvnw spring-boot:run.

# ----- Base de datos (usadas por docker-compose y por Spring) -----
POSTGRES_DB=brakket
POSTGRES_USER=brakket
POSTGRES_PASSWORD=brakket

# Si corres el backend fuera de docker (mvn spring-boot:run) usa estas:
DB_URL=jdbc:postgresql://localhost:5432/brakket
DB_USER=brakket
DB_PASSWORD=brakket

# ----- Frontend permitido para CORS -----
FRONTEND_URL=http://localhost:4200

# ----- Google OAuth2 (EPIC-01) -----
# Crear credenciales tipo "OAuth client ID → Web application" en:
#   https://console.cloud.google.com/apis/credentials
# En "Authorized redirect URIs" registrar EXACTAMENTE (para desarrollo local):
#   http://localhost:8080/login/oauth2/code/google
# Con "changeme" la app arranca pero el login con Google NO funciona hasta poner las reales.
# Sugerencia de equipo: un único client de Google compartido para desarrollo.
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# ----- JWT (token que emite Brakket tras el login con Google) -----
# Debe tener al menos 32 caracteres.
JWT_SECRET=cambiar-esta-clave-secreta-de-al-menos-32-chars
JWT_EXPIRATION_MS=86400000

# ----- Twitch (EPIC-10) -----
# Registrar app en https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=brakketcenfotec
# Fail-fast: con true (default) el backend NO arranca si faltan las credenciales
# de Twitch. Ponerlo en false solo en entornos sin secretos (test/CI).
TWITCH_REQUIRED=true
# false = /transmisiones muestra solo el canal oficial de Brakket;
# true = incorpora también las transmisiones registradas (RF-35).
STREAMS_MULTI_SOURCE_ENABLED=false

# ----- Servicio de IA / análisis de sentimiento (EPIC-10) -----
AI_API_KEY=
AI_API_BASE_URL=
