# ===== Brakket - variables de entorno (raíz del monorepo) =====
# Copiar a .env y completar. NO subir .env al repositorio.
# Lo usa docker-compose.yml (en esta carpeta) y también el backend si exportas
# estas variables al correr ./mvnw spring-boot:run.

# ----- Base de datos (usadas por docker-compose y por Spring) -----
POSTGRES_DB=brakket
POSTGRES_USER=brakket
POSTGRES_PASSWORD=brakket

# Si corres el backend fuera de docker (mvn spring-boot:run) usa estas:
DB_URL=jdbc:postgresql://localhost:5432/brakket
DB_USER=brakket
DB_PASSWORD=brakket

# ----- Frontend permitido para CORS -----
FRONTEND_URL=http://localhost:4200

# ----- Google OAuth2 (EPIC-01) -----
# Crear credenciales tipo "OAuth client ID → Web application" en:
#   https://console.cloud.google.com/apis/credentials
# En "Authorized redirect URIs" registrar EXACTAMENTE (para desarrollo local):
#   http://localhost:8080/login/oauth2/code/google
# Con "changeme" la app arranca pero el login con Google NO funciona hasta poner las reales.
# Sugerencia de equipo: un único client de Google compartido para desarrollo.
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# ----- JWT (token que emite Brakket tras el login con Google) -----
# Debe tener al menos 32 caracteres.
JWT_SECRET=cambiar-esta-clave-secreta-de-al-menos-32-chars
JWT_EXPIRATION_MS=86400000

# ----- Twitch (EPIC-10) -----
# Registrar app en https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=brakketcenfotec
# Fail-fast: con true (default) el backend NO arranca si faltan las credenciales
# de Twitch. Ponerlo en false solo en entornos sin secretos (test/CI).
TWITCH_REQUIRED=true
# false = /transmisiones muestra solo el canal oficial de Brakket;
# true = incorpora también las transmisiones registradas (RF-35).
STREAMS_MULTI_SOURCE_ENABLED=false

# ----- Catálogo de juegos -----
# De dónde salen los títulos, las portadas y las fichas: igdb (default) o rawg.
#   igdb = NO pide credenciales propias, reutiliza las de Twitch de arriba.
#   rawg = respaldo; necesita RAWG_API_KEY (abajo).
# Dejar esto vacío o sin la línea usa igdb. RAWG se mantiene por si IGDB deja
# de responder: se pone rawg acá y se recrea el backend, sin tocar código.
# Ojo: cambiar de proveedor no re-baja el arte de los juegos ya sembrados; solo
# se refresca el de los que aún no tienen ficha (ver CatalogoSeeder).
CATALOGO_PROVEEDOR=igdb
# Solo se usa con CATALOGO_PROVEEDOR=rawg. Key gratuita en
# https://rawg.io/apidocs. Sin ella, ese respaldo siembra los juegos sin
# portada (placeholder con la inicial).
RAWG_API_KEY=

# ----- Servicio de IA: sentimiento del chat y asistente (EPIC-10) -----
# Llave gratuita de Google AI Studio (https://aistudio.google.com/apikey); no
# pide tarjeta. SIN esta llave nada se cae: el analisis de sentimiento (RF-39)
# usa el analizador lexico, que es determinista y no sale a la red, y el
# asistente del termometro (RF-40) responde con los numeros que el backend ya
# calculo. Con la llave, cada bloque de chat que captura RF-38 se clasifica con
# el modelo y el asistente redacta sobre esos datos.
GEMINI_API_KEY=
# El alias -latest apunta siempre al flash vigente. NO fijar una version
# concreta: Google las jubila y devuelven 404 aunque sigan apareciendo en el
# listado de modelos de la API.
GEMINI_MODEL=gemini-flash-latest
